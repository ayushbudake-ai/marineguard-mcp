{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarineGuard Detection Output",
  "description": "Standard detector output contract for Role 2 and downstream roles.",
  "type": "object",
  "required": ["frame_id", "model_version", "detections"],
  "properties": {
    "frame_id": {
      "type": "string",
      "description": "Unique image or frame identifier."
    },
    "model_version": {
      "type": "string",
      "description": "Version of the detector used for inference.",
      "examples": ["v1"]
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class_id", "class_name", "confidence", "bbox"],
        "properties": {
          "class_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 49
          },
          "class_name": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox": {
            "type": "object",
            "required": ["x1", "y1", "x2", "y2"],
            "properties": {
              "x1": { "type": "number" },
              "y1": { "type": "number" },
              "x2": { "type": "number" },
              "y2": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
